{
    "name": "becklyn/rad",
    "description": "RAD related functionality for usage in Symfony.",
    "license": "BSD-3-Clause",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Becklyn Studios",
            "homepage": "http://becklyn.com/"
        }
    ],
    "homepage": "https://github.com/Becklyn/rad",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "beberlei/doctrineextensions": "^1.3.0",
        "becklyn/rad-bundles": "^1.1.0",
        "doctrine/doctrine-bundle": "^2.5.6",
        "doctrine/orm": "^2.11.1",
        "psr/log": "^1.1.4",
        "scienta/doctrine-json-functions": "^4.5.0 || ^5.0.0",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/form": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/property-access": "^6.4",
        "symfony/translation-contracts": "^3.0.0",
        "symfony/validator": "^6.4",
        "twig/twig": "^3.3.8"
    },
    "require-dev": {
        "algolia/search-bundle": "^5.2.1 || ^6.0.0",
        "roave/security-advisories": "dev-master",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/twig-bridge": "^6.4"
    },
    "conflict": {
        "becklyn/rad-bundle": "*"
    },
    "suggest": {
        "symfony/twig-bridge": "To use the default form theme."
    },
    "autoload": {
        "psr-4": {
            "Becklyn\\Rad\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Becklyn\\Rad\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-next": "8.x-dev"
        }
    }
}
